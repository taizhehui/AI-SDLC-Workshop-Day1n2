# Copy to .env.local and adjust for your environment.

# Secret used to sign session JWTs. MUST be set in production (min 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# WebAuthn Relying Party configuration.
# RP_ID must be the bare domain (no scheme, no port). Use "localhost" for local dev.
RP_ID=localhost
RP_NAME=Todo App
# Full origin including scheme and port.
RP_ORIGIN=http://localhost:3000

# Path to the SQLite database file. Defaults to ./todos.db in the project root.
# DATABASE_PATH=todos.db
